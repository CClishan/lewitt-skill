    "patterns": [
      {
        "id": "p-accent-restraint",
        "name": "White-only action color",
        "rule": "The only saturated accent is a one-off hero word; every actionable surface resolves to white-on-near-black or 1px rings.",
        "goal": "Lets emphasis come from position and weight, so the product mock stays the brightest thing on the page.",
        "evidence": [
          "e-nav-cta",
          "e-text-pink-hero",
          "e-text-primary"
        ]
      },
      {
        "id": "p-weight-not-size",
        "name": "Weight and tracking beat size jumps",
        "rule": "Hierarchy is carried by 400/510/590 and -2.2% tracking at display sizes, not by bold weights or a long type scale.",
        "goal": "Keeps headings calm at 64px so a dense product screenshot can sit underneath without competing.",
        "evidence": [
          "e-weight-dist",
          "e-weight-dist-other",
          "e-h1"
        ]
      },
      {
        "id": "p-ui-band",
        "name": "Tight UI band, wide display jumps",
        "rule": "86% of text sits in 12-16px; display sizes jump straight to 20/32/48/64 with no intermediate steps.",
        "goal": "Treats UI chrome as one texture and the marketing headline as a poster line — nothing in between competes.",
        "evidence": [
          "e-size-dist",
          "e-size-dist-pricing"
        ]
      },
      {
        "id": "p-ring-depth",
        "name": "Rings instead of shadows",
        "rule": "Depth is a 1px inset/outset ring at 3-20% alpha; only genuinely floating panels get a soft shadow.",
        "goal": "Keeps dark surfaces from looking muddy and stops cards from stacking into a shadow ladder.",
        "evidence": [
          "e-shadows",
          "e-shadows-other"
        ]
      },
      {
        "id": "p-whitespace-in-sections",
        "name": "Breathing room lives inside sections",
        "rule": "Section-to-section gap is 10px; the 224px of air is padding inside a band, not margin between bands.",
        "goal": "Makes the page read as one continuous dark canvas rather than a stack of cards.",
        "evidence": [
          "e-gaps",
          "e-home-bg"
        ]
      },
      {
        "id": "p-product-as-visual",
        "name": "Real product UI is the illustration",
        "rule": "The hero visual is a rendered app frame (232px sidebar + 1072px canvas) with real states, not abstract art.",
        "goal": "Shows the actual workflow at the exact density users buy the product for.",
        "evidence": [
          "e-grid",
          "e-font-mono"
        ]
      },
      {
        "id": "p-short-motion",
        "name": "Feedback motion only",
        "rule": "Transitions are 100-160ms on border/background/color, with :focus-visible and a reduced-motion branch present.",
        "goal": "Confirms interaction without delaying it; state stays legible with motion disabled.",
        "evidence": [
          "e-motion",
          "e-focus-rm"
        ]
      }
    ],
